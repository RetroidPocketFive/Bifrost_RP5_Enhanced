<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080C18">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/samplingHeaderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="#101629"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="#6865F2"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/samplingBackButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:contentDescription="Back"
                android:text=""
                app:backgroundTint="#151D33"
                app:cornerRadius="12dp"
                app:icon="@drawable/baseline_arrow_back_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="#F2F4FF"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp" />

            <ImageView
                android:id="@+id/samplingHeaderLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="BIFROST logo"
                android:scaleType="fitCenter"
                app:srcCompat="@mipmap/ic_launcher" />

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                android:background="#252E48" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/samplingHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calibration"
                    android:textColor="#F2F4FF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/samplingHeaderDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Test and calibrate controller lighting."
                    android:textColor="#8992AD"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/chooserPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose an image source"
            android:textColor="#F2F4FF"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:text="Choose a live screen or a still image to configure sampling areas."
            android:textColor="#8992AD"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChooseLive"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="LIVE GAME SCREEN"
                app:cornerRadius="14dp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#6865F2"
                android:minHeight="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChooseStill"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="STILL IMAGE"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="LIVE waits 5 seconds, then captures the game. STILL lets you choose a screenshot."
            android:textColor="#68738F"
            android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/editorPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/editorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LEFT STICK"
                android:textColor="#F2F4FF"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/editorSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zoomed view."
                android:textColor="#8992AD"
                android:textSize="9sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#101629">

            <com.moonbench.bifrost.ui.SamplingCanvasView
                android:id="@+id/samplingCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/samplingPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="No reference image. The sampling box can still be positioned."
                android:textColor="#8992AD"
                android:textSize="9sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/leftReferenceButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="LEFT"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightReferenceButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="RIGHT"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecapture"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="RECAPTURE"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="RESET"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDisable"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="DISABLE"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:padding="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="BACK"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="NEXT"
                app:cornerRadius="14dp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#6865F2"
                android:minHeight="48dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/colorTestPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/colorTestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LED COLOR MATCH"
            android:textColor="#F2F4FF"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/colorTestSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Match the physical LED to the screen colour. Adjust raw RGB, test it, then save the primary. Green can be corrected independently from blue."
            android:textColor="#8992AD"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMatchLeft"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="LEFT STICK"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />

            <TextView
                android:id="@+id/matchStickName"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.75"
                android:gravity="center"
                android:text="SELECT: LEFT"
                android:textColor="#F2F4FF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMatchRight"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="RIGHT STICK"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SCREEN TARGET"
                    android:textColor="#8992AD"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/targetColorSwatch"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#00FF00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RAW LED COMMAND"
                    android:textColor="#8992AD"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/rawColorSwatch"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#00FF00" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/testColorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="RED"
            android:textColor="#F2F4FF"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/redValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R 255"
            android:textColor="#FF7777"
            android:textSize="9sp" />

        <SeekBar
            android:id="@+id/redSeek"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:max="255" />

        <TextView
            android:id="@+id/greenValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="G 255"
            android:textColor="#77FF77"
            android:textSize="9sp" />

        <SeekBar
            android:id="@+id/greenSeek"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:max="255" />

        <TextView
            android:id="@+id/blueValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="B 255"
            android:textColor="#7799FF"
            android:textSize="9sp" />

        <SeekBar
            android:id="@+id/blueSeek"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:max="255" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestAdjusted"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="TEST RAW LED"
                app:cornerRadius="14dp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#6865F2"
                android:minHeight="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePrimary"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="SAVE PRIMARY"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetLedCalibration"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="RESET"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnColorBack"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="BACK"
                app:cornerRadius="12dp"
                android:textColor="#F2F4FF"
                app:backgroundTint="#151D33"
                app:strokeColor="#6865F2"
                app:strokeWidth="1dp"
                android:minHeight="44dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnColorNext"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="NEXT PRIMARY"
                app:cornerRadius="14dp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#6865F2"
                android:minHeight="48dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishCalibration"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="SAVE &amp; APPLY"
                app:cornerRadius="14dp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#6865F2"
                android:minHeight="48dp" />
    </LinearLayout>
</LinearLayout>