<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/bifrost_screen_padding"
    android:background="@color/bifrost_bg">

    <!-- Independent Profile Settings screen. Fixed header, actions and category tabs. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/profileSettingsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/bifrost_card"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/bifrost_accent"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileSettingsExitButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:padding="0dp"
                android:contentDescription="Exit Profile Settings"
                android:text="‹"
                android:textSize="28sp"
                android:textColor="@color/bifrost_text"
                app:cornerRadius="12dp"
                app:strokeColor="@color/bifrost_border" />

            <ImageView
                android:id="@+id/profileSettingsLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:contentDescription="BIFROST logo"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@color/bifrost_border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROFILE SETTINGS"
                    android:textColor="@color/bifrost_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Configure the selected preset and its behaviour."
                    android:textColor="@color/bifrost_text_secondary"
                    android:textSize="13sp"
                    android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Fixed profile action region; deliberately no settings controls below it yet. -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/bifrost_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/bifrost_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <Spinner
                android:id="@+id/profileSettingsPresetSpinner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:contentDescription="Select profile"
                android:backgroundTint="@color/bifrost_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="4">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profileSettingsSaveButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:text="Save"
                    android:textSize="13sp"
                    android:textColor="@color/bifrost_text"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/bifrost_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profileSettingsEditButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:minWidth="0dp"
                    android:text="Edit"
                    android:textSize="13sp"
                    android:textColor="@color/bifrost_text"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/bifrost_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profileSettingsRestoreButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:minWidth="0dp"
                    android:text="Restore"
                    android:textSize="13sp"
                    android:textColor="@color/bifrost_text"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/bifrost_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profileSettingsDeleteButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:text="Delete"
                    android:textSize="13sp"
                    android:textColor="@color/bifrost_error"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/bifrost_error" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Fixed category navigation; content is intentionally not populated yet. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileSettingsArtworkTab"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Artwork"
            android:textSize="13sp"
            android:textColor="@color/bifrost_text"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/bifrost_selected"
            app:strokeColor="@color/bifrost_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileSettingsThemesTab"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="Themes"
            android:textSize="13sp"
            android:textColor="@color/bifrost_text"
            app:cornerRadius="12dp"
            app:strokeColor="@color/bifrost_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileSettingsWallpaperTab"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Wallpaper"
            android:textSize="13sp"
            android:textColor="@color/bifrost_text"
            app:cornerRadius="12dp"
            app:strokeColor="@color/bifrost_accent" />
    </LinearLayout>

    <!-- Empty by design until the user approves this page's structure. -->
    <FrameLayout
        android:id="@+id/profileSettingsContentHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
