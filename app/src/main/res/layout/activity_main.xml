<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bifrost_bg">

    <LinearLayout
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/bifrost_screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/homeBifrostLogoView"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/app_name"
                    android:padding="2dp"
                    app:srcCompat="@mipmap/ic_launcher" />

                <TextView
                    android:id="@+id/homeBifrostTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BIFROST"
                    android:textColor="@color/bifrost_text"
                    android:textSize="@dimen/bifrost_title_size"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:shadowColor="@color/bifrost_glow_purple"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="20"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="none" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="190dp"
                android:layout_height="52dp"
                android:layout_weight="0"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/bifrost_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/bifrost_accent"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/systemStatusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_glow_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LED SERVICE"
                            android:textColor="@color/bifrost_text"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Turns Bifrost LED control on or off"
                            android:textColor="@color/bifrost_text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/serviceToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_tint"
                        app:trackTint="@color/switch_track_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="190dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APP PROFILES"
                        android:textColor="@color/bifrost_text"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Switch presets by app"
                        android:textColor="@color/bifrost_text_secondary"
                        android:textSize="8sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/homeAppProfileSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    app:thumbTint="@color/switch_thumb_tint"
                    app:trackTint="@color/switch_track_tint" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeSettingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/settings_gear_symbol"
                android:textColor="@color/bifrost_text"
                android:textSize="24sp"
                android:backgroundTint="@color/bifrost_surface"
                app:cornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bifrost_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeMaintenanceRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeScreenMonitorButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="SCREEN MONITOR"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeClearCacheButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="CLEAR CACHE"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="PRESETS  •  Swipe left/right to choose • tap to activate"
            android:textColor="@color/bifrost_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <com.moonbench.bifrost.ui.LockableHorizontalScrollView
            android:id="@+id/presetCoverFlowScroll"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="8dp"
            android:minHeight="176dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/presetCoverFlowContainer"
                android:layout_width="wrap_content"
                android:layout_height="176dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </com.moonbench.bifrost.ui.LockableHorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/activePresetInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/bifrost_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/bifrost_accent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glow_bg"
                android:orientation="vertical"
                android:padding="@dimen/bifrost_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT PRESET"
                    android:textColor="@color/bifrost_text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/activePresetNameText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Default"
                        android:textColor="@color/bifrost_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/activePresetStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_active_bg"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="ACTIVE"
                        android:textColor="@color/bifrost_text"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/activePresetAnimationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Animation: Static"
                    android:textColor="@color/bifrost_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/activePresetProfileText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Profile: High"
                    android:textColor="@color/bifrost_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <include layout="@layout/layout_settings_panel" />
    </FrameLayout>
</FrameLayout>
