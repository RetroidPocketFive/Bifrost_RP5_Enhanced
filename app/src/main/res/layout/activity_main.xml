<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bifrost_bg">

    <LinearLayout
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/bifrost_screen_padding">

        
        
        <LinearLayout
            android:id="@+id/homeHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2.6"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/bifrost_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/bifrost_accent"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingEnd="4dp">
                    <ImageView
                        android:id="@+id/homeBifrostLogoView"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/app_name"
                        android:padding="2dp"
                        app:srcCompat="@mipmap/ic_launcher" />
                    <TextView
                        android:id="@+id/homeBifrostTitleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BIFROST"
                        android:textColor="@color/bifrost_text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:maxLines="1"
                        android:singleLine="true" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeSettingsButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="@string/settings_gear_symbol"
                        android:contentDescription="Open Bifrost settings"
                        android:tooltipText="Open settings"
                        android:textColor="@color/bifrost_text"
                        android:textSize="22sp"
                        android:backgroundTint="@color/bifrost_surface"
                        app:cornerRadius="10dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/bifrost_accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="3.2"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/bifrost_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/bifrost_accent"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/systemStatusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/homeHeimdallTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Heimdall"
                            android:textColor="@color/bifrost_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Bifrost LED screen monitoring"
                            android:textColor="@color/bifrost_text_secondary"
                            android:textSize="7sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/serviceToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Bifrost LED screen monitoring"
                        android:focusable="true"
                        android:minWidth="48dp"
                        app:thumbTint="@color/switch_thumb_tint"
                        app:trackTint="@color/switch_track_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2.7"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/bifrost_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/bifrost_accent"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="APP PROFILES"
                            android:textColor="@color/bifrost_text"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:singleLine="true" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Automatically switch presets by app"
                            android:textColor="@color/bifrost_text_secondary"
                            android:textSize="8sp"
                            android:singleLine="true" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/homeAppProfileSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Enable app based profiles"
                        app:thumbTint="@color/switch_thumb_tint"
                        app:trackTint="@color/switch_track_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeExitButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="0.85"
                android:minWidth="64dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="EXIT"
                android:textSize="9sp"
                android:contentDescription="Close Bifrost"
                android:tooltipText="Close Bifrost"
                android:backgroundTint="@color/bifrost_surface"
                app:cornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bifrost_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeMaintenanceRow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeClearCacheButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="112dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="CLEAR CACHE"
                android:textSize="10sp"
                android:contentDescription="Clear temporary Bifrost cache"
                android:tooltipText="Clear temporary Bifrost cache" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="PRESETS  •  Swipe left/right to choose • tap to activate"
            android:textColor="@color/bifrost_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <com.moonbench.bifrost.ui.LockableHorizontalScrollView
            android:id="@+id/presetCoverFlowScroll"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="8dp"
            android:minHeight="176dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/presetCoverFlowContainer"
                android:layout_width="wrap_content"
                android:layout_height="176dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </com.moonbench.bifrost.ui.LockableHorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/activePresetInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/bifrost_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/bifrost_accent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glow_bg"
                android:orientation="vertical"
                android:padding="@dimen/bifrost_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT PRESET"
                    android:textColor="@color/bifrost_text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/activePresetNameText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Default"
                        android:textColor="@color/bifrost_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/activePresetStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_active_bg"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="ACTIVE"
                        android:textColor="@color/bifrost_text"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/activePresetAnimationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Animation: Static"
                    android:textColor="@color/bifrost_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/activePresetProfileText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Profile: High"
                    android:textColor="@color/bifrost_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <include layout="@layout/layout_settings_panel" />
    </FrameLayout>
</FrameLayout>
