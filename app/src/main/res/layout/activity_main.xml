<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bifrost_bg">

    <LinearLayout
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/bifrost_screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/homeBifrostLogoView"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/app_name"
                    android:padding="2dp"
                    app:srcCompat="@mipmap/ic_launcher" />

                <TextView
                    android:id="@+id/homeBifrostTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BIFROST"
                    android:textColor="@color/bifrost_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:shadowColor="@color/bifrost_glow_purple"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="18"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeSettingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/settings_gear_symbol"
                android:textColor="@color/bifrost_text"
                android:textSize="23sp"
                android:backgroundTint="@color/bifrost_surface"
                app:cornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bifrost_accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="@color/bifrost_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/bifrost_accent"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/systemStatusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="7dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HEIMDALL"
                            android:textColor="@color/bifrost_text"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.025" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Turns Bifrost LED control on or off"
                            android:textColor="@color/bifrost_text_secondary"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/serviceToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_tint"
                        app:trackTint="@color/switch_track_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.72"
                android:layout_marginStart="4dp"
                app:cardBackgroundColor="@color/bifrost_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/bifrost_accent"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="APP PROFILES"
                            android:textColor="@color/bifrost_text"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Automatically switch presets by app"
                            android:textColor="@color/bifrost_text_secondary"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/homeAppProfileSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_tint"
                        app:trackTint="@color/switch_track_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeClearCacheButton"
            android:layout_width="150dp"
            android:layout_height="34dp"
            android:layout_gravity="end"
            android:layout_marginTop="7dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="CLEAR CACHE"
            android:textColor="@color/bifrost_text"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:backgroundTint="@color/bifrost_surface"
            app:cornerRadius="11dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/bifrost_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="PRESET PROFILES"
            android:textColor="@color/bifrost_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Swipe left/right to select a profile • tap to activate • long-press to edit"
            android:textColor="@color/bifrost_text_secondary"
            android:textSize="8sp" />

        <com.moonbench.bifrost.ui.LockableHorizontalScrollView
            android:id="@+id/presetCoverFlowScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:minHeight="110dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/presetCoverFlowContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </com.moonbench.bifrost.ui.LockableHorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/activePresetInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/bifrost_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/bifrost_accent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glow_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/activePresetNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default"
                    android:textColor="@color/bifrost_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/activePresetStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/activePresetAnimationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Animation: Static"
                    android:textColor="@color/bifrost_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/activePresetProfileText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Profile: High"
                    android:textColor="@color/bifrost_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <include layout="@layout/layout_settings_panel" />
    </FrameLayout>
</FrameLayout>